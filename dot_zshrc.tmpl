# Section order below is load-bearing. Do not reshuffle casually:
#   1. p10k instant prompt must stay at the very top.
#   2. oh-my-zsh must load before anything that depends on its plugins.
#   3. PATH must be settled before zoxide initialises.
#   8. zoxide must be last. It hooks precmd/chpwd, and anything that touches
#      PATH after it trips the zoxide doctor warning.

# --- 1. powerlevel10k instant prompt ------------------------------------------
# Anything requiring console input (password prompts, y/n) must go ABOVE this.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- 2. oh-my-zsh -------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                    # empty: powerlevel10k is sourced directly below
ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="true"

plugins=(
  autoupdate
  git
  gitfast
  colorize
  mix
  elixir
  docker
  docker-compose
  asdf
  brew
  fzf
  zsh-autosuggestions
  zsh-claudecode-completion
)

source $ZSH/oh-my-zsh.sh

# --- 3. PATH ------------------------------------------------------------------
# Single consolidated block. Every optional entry is guarded on existence so a
# machine without the tool gets a clean PATH instead of a dead segment.
_prepend_path() { [[ -d "$1" ]] && PATH="$1:$PATH"; }

_prepend_path "/usr/local/sbin"
_prepend_path "$HOME/.cargo/bin"
_prepend_path "$HOME/.opencode/bin"
_prepend_path "$HOME/.local/bin"

# asdf shims, stated explicitly. The omz asdf plugin also wires this up by
# sourcing $(brew --prefix asdf)/libexec/asdf.sh, but that is a compat shim
# whose survival is not guaranteed. Harmless no-op when asdf is not installed.
_prepend_path "${ASDF_DATA_DIR:-$HOME/.asdf}/shims"

unset -f _prepend_path
export PATH

# --- 4. powerlevel10k ---------------------------------------------------------
# Stable opt path, never a versioned Cellar path: the latter breaks on every
# `brew upgrade`.
_p10k="$(brew --prefix)/opt/powerlevel10k/share/powerlevel10k/powerlevel10k.zsh-theme"
if [[ -f "$_p10k" ]]; then
  source "$_p10k"
else
  print -u2 "zshrc: powerlevel10k missing. Run: brew bundle --file=~/.config/homebrew/Brewfile"
fi
unset _p10k
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# --- 5. zsh-syntax-highlighting -----------------------------------------------
# Path confirmed against the formula's own caveats.
_zsh_hl="$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
if [[ -f "$_zsh_hl" ]]; then
  source "$_zsh_hl"
else
  print -u2 "zshrc: zsh-syntax-highlighting missing. Run: brew bundle --file=~/.config/homebrew/Brewfile"
fi
unset _zsh_hl

# --- 6. aliases ---------------------------------------------------------------
# Modern CLI replacements. These are why the core Brewfile is not optional.
alias cat='bat --paging=never'
alias ls='eza --icons --group-directories-first'
alias ll='eza -la --icons --group-directories-first --git'
alias tree='eza --tree --icons --group-directories-first'
alias grep='rg'
alias find='fd'
alias diff='delta'

# git
alias gcane='git commit --amend --no-edit'
alias gredo='gaa && gcane && ggfl'
alias grecents='git branch --sort=-committerdate'

# elixir
alias mcwae='mix compile --warnings-as-errors'
alias ipsasl='iex --logger-sasl-reports true -S mix phx.server'

# node
alias nrs='npm run start'
alias asm='ava --serial -m'

# shell ergonomics
alias ln='ln -i'
alias md='mkdir -p'
alias rd='rmdir'
alias _=sudo
alias __='sudo $(fc -ln -1)'
alias :q=exit
alias ghostty='open -a Ghostty'
{{ if eq .role "personal" }}
# forge-symphony / Jidoka
alias sj='{{ .chezmoi.homeDir }}/projects/forge-symphony/bin/start'
alias ccj='claude --dangerously-load-development-channels server:forge-symphony'
{{- end }}

# --- 7. exports ---------------------------------------------------------------
export KERL_CONFIGURE_OPTIONS="--without-javac"

export GIT_PAGER='delta'

export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# --- 8. zoxide, last ----------------------------------------------------------
eval "$(zoxide init zsh)"
alias cd='z'
